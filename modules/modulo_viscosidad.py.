import numpy as np

def calcular_viscosidad_temperatura(v1: float, t1_c: float, v2: float, t2_c: float, t_obj_c: float) -> float:
    """
    Estima la viscosidad cinemática/dinámica (cP o cSt) a una temperatura objetivo (t_obj_c)
    a partir de dos mediciones de laboratorio conocidas (v1 a t1_c y v2 a t2_c), 
    empleando la relación de Walther (ASTM D341).

    Parámetros:
        v1 (float): Viscosidad medida 1 (cP o cSt)
        t1_c (float): Temperatura de la medición 1 (°C)
        v2 (float): Viscosidad medida 2 (cP o cSt)
        t2_c (float): Temperatura de la medición 2 (°C)
        t_obj_c (float): Temperatura objetivo para la estimación (°C)

    Retorna:
        float: Viscosidad estimada a t_obj_c (redondeada a 2 decimales)
    """
    try:
        # Conversión de temperaturas de °C a Kelvin (K)
        t1_k = t1_c + 273.15
        t2_k = t2_c + 273.15
        t_obj_k = t_obj_c + 273.15

        # Evitar divisiones por cero o valores no válidos
        if t1_k == t2_k or v1 <= 0 or v2 <= 0:
            return float(round(v1, 2))

        # Doble logaritmo según la norma ASTM D341
        # log10(log10(v + 0.7)) vs log10(T)
        log_v1 = np.log10(np.log10(v1 + 0.7))
        log_v2 = np.log10(np.log10(v2 + 0.7))
        log_t1 = np.log10(t1_k)
        log_t2 = np.log10(t2_k)

        # Pendiente B y constante A de la recta ASTM
        b = (log_v1 - log_v2) / (log_t2 - log_t1)
        a = log_v1 + b * log_t1

        # Cálculo de la viscosidad a la temperatura objetivo
        log_v_obj = a - b * np.log10(t_obj_k)
        viscosidad_estimada = (10 ** (10 ** log_v_obj)) - 0.7

        # Validación para evitar valores no numéricos o infinitos
        if np.isnan(viscosidad_estimada) or np.isinf(viscosidad_estimada):
            raise ValueError("Cálculo fuera de rango numérico válido")

        return float(round(viscosidad_estimada, 2))

    except Exception:
        # Interpolación/Extrapolación semilogarítmica simple de respaldo (Fallback)
        try:
            ln_v1 = np.log(v1)
            ln_v2 = np.log(v2)
            slope = (ln_v2 - ln_v1) / (t2_c - t1_c)
            v_fallback = np.exp(ln_v1 + slope * (t_obj_c - t1_c))
            return float(round(v_fallback, 2))
        except Exception:
            return float(round(v1, 2))


def evaluar_clasificacion_viscosidad(viscosidad_cp: float) -> tuple[str, str]:
    """
    Clasifica la fluidez del crudo según su viscosidad operativa a la temperatura de transporte/bombeo.

    Retorna:
        tuple[str, str]: (Categoría, Recomendación operativa)
    """
    if viscosidad_cp > 500:
        return (
            "ALTA VISCOSIDAD",
            "Riesgo de alta pérdida de carga en oleoductos. Se recomienda dilución con nafta/condensado o calentamiento en línea."
        )
    elif viscosidad_cp > 150:
        return (
            "VISCOSIDAD MODERADA",
            "Apto para transporte estándar, evaluar temperatura en puntos de control o agentes de reducción de fricción (DRA)."
        )
    else:
        return (
            "FLUIDEZ ÓPTIMA",
            "Excelente bombeabilidad y bajas pérdidas por fricción. No requiere tratamiento térmico ni dilución."
        )
